{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["src/*"],
      "@config/*": ["src/config/*"],
      "@modules/*": ["src/modules/*"],
      "@common/*": ["src/common/*"],
      "@database/*": ["src/database/*"],
      "@modules/auth/*": ["src/modules/auth/*"],
      "@modules/users/*": ["src/modules/users/*"],
      "@modules/roles/*": ["src/modules/roles/*"],
      "@modules/permissions/*": ["src/modules/permissions/*"],
      "@modules/branches/*": ["src/modules/branches/*"],
      "@modules/products/*": ["src/modules/products/*"],
      "@modules/categories/*": ["src/modules/categories/*"],
      "@modules/brands/*": ["src/modules/brands/*"],
      "@modules/inventory/*": ["src/modules/inventory/*"],
      "@modules/favorites/*": ["src/modules/favorites/*"],
      "@modules/cart/*": ["src/modules/cart/*"],
      "@modules/orders/*": ["src/modules/orders/*"],
      "@modules/payments/*": ["src/modules/payments/*"],
      "@modules/refunds/*": ["src/modules/refunds/*"],
      "@modules/promotions/*": ["src/modules/promotions/*"],
      "@modules/uds/*": ["src/modules/uds/*"],
      "@modules/reviews/*": ["src/modules/reviews/*"],
      "@modules/consultations/*": ["src/modules/consultations/*"],
      "@modules/notifications/*": ["src/modules/notifications/*"],
      "@modules/cms/*": ["src/modules/cms/*"],
      "@modules/analytics/*": ["src/modules/analytics/*"],
      "@modules/audit/*": ["src/modules/audit/*"],
      "@common/decorators/*": ["src/common/decorators/*"],
      "@common/guards/*": ["src/common/guards/*"],
      "@common/filters/*": ["src/common/filters/*"],
      "@common/interceptors/*": ["src/common/interceptors/*"],
      "@common/middleware/*": ["src/common/middleware/*"],
      "@common/utils/*": ["src/common/utils/*"]
    }
  }
}
