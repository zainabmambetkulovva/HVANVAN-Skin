# Local environment file - DO NOT commit to version control

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database - Neon PostgreSQL
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require
DIRECT_URL=postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Prisma
PRISMA_GENERATE_ENDPOINT=http://localhost:3000

# UDS Integration
UDS_API_URL=https://uds-api.example.com
UDS_API_KEY=your-uds-api-key

# Payment Providers
MBANK_CLIENT_ID=mbank-client-id
MBANK_SECRET_KEY=mbank-secret-key
O_MONEY_CLIENT_ID=o-money-client-id
O_MONEY_SECRET_KEY=o-money-secret-key
ELCART_CLIENT_ID=elcart-client-id
ELCART_SECRET_KEY=elcart-secret-key
BALANCE_CLIENT_ID=balance-client-id
BALANCE_SECRET_KEY=balance-secret-key
FINIK_CLIENT_ID=finik-client-id
FINIK_SECRET_KEY=finik-secret-key
OPTIMA_BANK_CLIENT_ID=optima-bank-client-id
OPTIMA_BANK_SECRET_KEY=optima-bank-secret-key
BAKAI_BANK_CLIENT_ID=bakai-bank-client-id
BAKAI_BANK_SECRET_KEY=bakai-bank-secret-key

# WhatsApp
WHATSAPP_API_URL=https://whatsapp-api.example.com
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# Push Notifications
PUSH_API_KEY=your-push-api-key

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads
