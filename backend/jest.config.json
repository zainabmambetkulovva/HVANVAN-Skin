{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": ["**/*.(t|j)s"],
  "coverageDirectory": "../coverage",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/$1",
    "^@config/(.*)$": "<rootDir>/config/$1",
    "^@modules/(.*)$": "<rootDir>/modules/$1",
    "^@common/(.*)$": "<rootDir>/common/$1",
    "^@database/(.*)$": "<rootDir>/database/$1",
    "^@modules/auth/(.*)$": "<rootDir>/modules/auth/$1",
    "^@modules/users/(.*)$": "<rootDir>/modules/users/$1",
    "^@modules/roles/(.*)$": "<rootDir>/modules/roles/$1",
    "^@modules/permissions/(.*)$": "<rootDir>/modules/permissions/$1",
    "^@modules/branches/(.*)$": "<rootDir>/modules/branches/$1",
    "^@modules/products/(.*)$": "<rootDir>/modules/products/$1",
    "^@modules/categories/(.*)$": "<rootDir>/modules/categories/$1",
    "^@modules/brands/(.*)$": "<rootDir>/modules/brands/$1",
    "^@modules/inventory/(.*)$": "<rootDir>/modules/inventory/$1",
    "^@modules/favorites/(.*)$": "<rootDir>/modules/favorites/$1",
    "^@modules/cart/(.*)$": "<rootDir>/modules/cart/$1",
    "^@modules/orders/(.*)$": "<rootDir>/modules/orders/$1",
    "^@modules/payments/(.*)$": "<rootDir>/modules/payments/$1",
    "^@modules/refunds/(.*)$": "<rootDir>/modules/refunds/$1",
    "^@modules/promotions/(.*)$": "<rootDir>/modules/promotions/$1",
    "^@modules/uds/(.*)$": "<rootDir>/modules/uds/$1",
    "^@modules/reviews/(.*)$": "<rootDir>/modules/reviews/$1",
    "^@modules/consultations/(.*)$": "<rootDir>/modules/consultations/$1",
    "^@modules/notifications/(.*)$": "<rootDir>/modules/notifications/$1",
    "^@modules/cms/(.*)$": "<rootDir>/modules/cms/$1",
    "^@modules/analytics/(.*)$": "<rootDir>/modules/analytics/$1",
    "^@modules/audit/(.*)$": "<rootDir>/modules/audit/$1",
    "^@common/decorators/(.*)$": "<rootDir>/common/decorators/$1",
    "^@common/guards/(.*)$": "<rootDir>/common/guards/$1",
    "^@common/filters/(.*)$": "<rootDir>/common/filters/$1",
    "^@common/interceptors/(.*)$": "<rootDir>/common/interceptors/$1",
    "^@common/middleware/(.*)$": "<rootDir>/common/middleware/$1",
    "^@common/utils/(.*)$": "<rootDir>/common/utils/$1"
  }
}